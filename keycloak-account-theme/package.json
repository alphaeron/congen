{
  "name": "congen-keycloak-account-theme",
  "version": "0.1.0",
  "description": "Congen Keycloak Account Theme",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "prestart": "keycloakify update-kc-gen && keycloakify copy-keycloak-resources-to-public",
    "start": "webpack serve --open --config webpack.dev.js",
    "prebuild": "keycloakify update-kc-gen",
    "build": "webpack --config webpack.prod.js",
    "postbuild": "rimraf dist/keycloakify-dev-resources",
    "devbuild": "webpack --config webpack.dev.js",
    "build-keycloak-theme": "npm run build && keycloakify build",
    "analyze": "npm run build && npx webpack-bundle-analyzer dist/",
    "analyze:dev": "npm run devbuild && npx webpack-bundle-analyzer dist/",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "coverage": "jest --coverage",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "type_check": "tsc --noEmit"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.1.1",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1",
    "@mui/material-pigment-css": "^7.3.1",
    "@pigment-css/react": "^0.0.30",
    "keycloakify": "^11.9.4",
    "process": "^0.11.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "7.26.0",
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.2.1",
    "compression-webpack-plugin": "^11.1.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.2.0",
    "file-loader": "^6.2.0",
    "globals": "^15.14.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mini-css-extract-plugin": "2.9.2",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.14",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "url-loader": "^4.1.1",
    "webpack": "^5.97.1",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0",
    "webpack-merge": "^6.0.1",
    "workbox-webpack-plugin": "^7.3.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "keycloakify": {
    "accountThemeImplementation": "Single-Page",
    "projectBuildDirPath": "dist",
    "staticDirPathInProjectBuildDirPath": "static",
    "publicDirPath": "public"
  }
}
