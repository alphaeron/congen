def estimate_hp_drain(intensity, duration, sleep_score, nutrition_score):
    # Base drain from workout
    base_drain = intensity * duration  # e.g., 0.8 * 1.5 hours = 1.2

    # Recovery modifier
    recovery_mod = 1 - (0.5 * sleep_score + 0.5 * nutrition_score)  # Scale 0–1

    # Final HP cost
    hp_drain = base_drain * (1 + recovery_mod)
    return round(hp_drain, 1)

