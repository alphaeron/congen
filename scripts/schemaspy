#!/bin/bash

# SchemaSpy wrapper script
# This script runs SchemaSpy using the downloaded JAR file

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCHEMASPY_JAR="$SCRIPT_DIR/../schemaspy.jar"

if [ ! -f "$SCHEMASPY_JAR" ]; then
    echo "Error: SchemaSpy JAR file not found at $SCHEMASPY_JAR"
    echo "Please download it from: https://github.com/schemaspy/schemaspy/releases"
    exit 1
fi

java -jar "$SCHEMASPY_JAR" "$@" 