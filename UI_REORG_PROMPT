5. Status System Integration Points

A. Status Data Structure
interface UserStatus {
  overall: 'excellent' | 'good' | 'fair' | 'needs_attention';
  strength: StatusMetric;
  cardio: StatusMetric;
  recovery: StatusMetric;
  nutrition: StatusMetric;
  lastUpdated: Date;
}

interface StatusMetric {
  value: number;
  unit: string;
  status: 'excellent' | 'good' | 'fair' | 'needs_attention';
  trend: 'up' | 'down' | 'stable';
  lastMeasurement: Date;
}

B. Status Display Components
- StatusCard: Primary status display with color coding
- StatusIndicator: Small status dots/chips for quick reference
- StatusProgress: Progress bars with status-based coloring
- StatusTooltip: Detailed status information on hover

