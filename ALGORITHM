FUNCTION generate_next_week(user_id, current_week_number, num_days_per_week):
    exercises = FETCH all exercises WITH muscle_groups, equipment, movement_type
    user_preferences = FETCH user preferences
    user_equipment = FETCH available equipment
    user_weak_muscles = FETCH weak muscle groups
    templates = SELECT_TEMPLATE(num_days_per_week)

    next_week_plan = []

    FOR day_template IN templates:
        workout = CREATE_NEW_WORKOUT(day_type=day_template.type, week=current_week_number)

        // 1. Primary Movement
        primary_exercise = SELECT_ROTATING_EXERCISE(
            user_id=user_id,
            movement_type=day_template.primary_movement,
            muscles=day_template.primary_muscles,
            equipment=user_equipment,
            preferences=user_preferences,
            category='primary'
        )

        primary_scheme = GENERATE_PRILEPIN_BASED_SCHEME(
            user_id=user_id,
            exercise=primary_exercise,
            movement_role='primary',
            day_type=day_template.type
        )

        ADD programmed_exercise TO workout.primary WITH primary_scheme

        // 2. Secondary (if exists)
        IF day_template.secondary_movement EXISTS:
            secondary_exercise = SELECT_ROTATING_EXERCISE(
                user_id=user_id,
                movement_type=day_template.secondary_movement,
                muscles=day_template.secondary_muscles,
                equipment=user_equipment,
                preferences=user_preferences,
                category='secondary'
            )

            secondary_scheme = GENERATE_PRILEPIN_BASED_SCHEME(
                user_id=user_id,
                exercise=secondary_exercise,
                movement_role='secondary',
                day_type=day_template.type
            )

            ADD programmed_exercise TO workout.secondary WITH secondary_scheme

        // 3. Accessory Movements
        FOR i IN 1 TO 3:
            accessory = SELECT_ROTATING_EXERCISE(
                user_id=user_id,
                movement_type='accessory',
                muscles=user_weak_muscles,
                equipment=user_equipment,
                preferences=user_preferences,
                category='accessory'
            )

            accessory_scheme = GENERATE_PRILEPIN_BASED_SCHEME(
                user_id=user_id,
                exercise=accessory,
                movement_role='accessory',
                day_type=day_template.type
            )

            ADD programmed_exercise TO workout.accessory WITH accessory_scheme

        // 4. Optional Conditioning
        IF day_template.include_conditioning:
            conditioning = SELECT_ROTATING_EXERCISE(
                user_id=user_id,
                movement_type='conditioning',
                muscles=['full_body'],
                equipment=user_equipment,
                preferences=user_preferences,
                category='conditioning'
            )

            conditioning_scheme = GENERATE_SCHEME_AMRAP_OR_EMOM(user_id, conditioning)

            ADD TO workout.cooldown WITH conditioning_scheme

        ADD workout TO next_week_plan

    RETURN next_week_plan

FUNCTION GENERATE_PRILEPIN_BASED_SCHEME(user_id, exercise, movement_role, day_type):
    prilepin = LOOKUP_PRILEPIN_GUIDELINES(day_type, movement_role)

    weight_percent = prilepin.intensity
    total_reps = prilepin.total_reps
    reps_per_set = RANDOM(prilepin.reps_per_set_range)
    num_sets = CEIL(total_reps / reps_per_set)

    // Tempo: vary if accessory, else default
    use_tempo = (movement_role != 'primary') AND (RANDOM_BOOL())

    eccentric = RANDOM_CHAR(['2', '3', '1']) IF use_tempo ELSE '0'
    isometric = RANDOM_CHAR(['1', '2', '0']) IF use_tempo ELSE '0'
    concentric = RANDOM_CHAR(['1', 'X']) IF use_tempo ELSE '0'

    // Determine Target Weight
    target_1rm = GET_USER_1RM(user_id, exercise.name)
    target_weight = target_1rm * weight_percent

    RETURN {
        is_amrap: false,
        is_emom: false,
        use_tempo: use_tempo,
        eccentric_tempo: eccentric,
        isometric_tempo: isometric,
        concentric_tempo: concentric,
        target_weight: ROUND(target_weight, 2),
        target_rep_count: reps_per_set,
        num_sets: num_sets
    }

FUNCTION LOOKUP_PRILEPIN_GUIDELINES(day_type, movement_role):
    IF movement_role == 'primary':
        IF 'ME' in day_type:
            RETURN {intensity: RANDOM(0.85, 0.92), reps_per_set_range: [2, 3, 4], total_reps: 15}
        ELSE IF 'DE' in day_type:
            RETURN {intensity: RANDOM(0.60, 0.70), reps_per_set_range: [2, 3], total_reps: 24}
    ELSE:
        RETURN {intensity: RANDOM(0.65, 0.75), reps_per_set_range: [6, 8, 10], total_reps: 30}

FUNCTION GENERATE_SCHEME_AMRAP_OR_EMOM(user_id, exercise):
    type = RANDOM_CHOICE(['amrap', 'emom'])

    use_tempo = RANDOM_BOOL()
    eccentric = RANDOM_CHAR(['2', '3']) IF use_tempo ELSE '0'
    isometric = RANDOM_CHAR(['1', '2']) IF use_tempo ELSE '0'
    concentric = RANDOM_CHAR(['1', 'X']) IF use_tempo ELSE '0'

    target_weight = GET_USER_1RM(user_id, exercise.name) * 0.5  // submaximal
    target_rep_count = NULL  // varies per person, based on test

    RETURN {
        is_amrap: type == 'amrap',
        is_emom: type == 'emom',
        use_tempo: use_tempo,
        eccentric_tempo: eccentric,
        isometric_tempo: isometric,
        concentric_tempo: concentric,
        target_weight: ROUND(target_weight, 2),
        target_rep_count: NULL
    }
