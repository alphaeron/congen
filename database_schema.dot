digraph DatabaseSchema {
    // Graph settings
    rankdir=LR;
    node [shape=record, fontname="Arial", fontsize=11];
    edge [fontname="Arial", fontsize=9];
    
    // Compact layout settings
    nodesep=0.8;
    ranksep=1.2;
    splines=polyline;
    size="16,10";
    ratio=fill;
    
    // Color scheme
    node [style=filled];
    equipment [fillcolor=lightcoral, label="{equipment|id\lname\lcreated_at\lupdated_at}"];
    exercise_equipment [fillcolor=lightcoral, label="{exercise_equipment|id\lname\lcreated_at\lupdated_at}"];
    exercise_muscle [fillcolor=lightcoral, label="{exercise_muscle|id\lname\lcreated_at\lupdated_at}"];
    exercise_rotation_history [fillcolor=lightcoral, label="{exercise_rotation_history|id\lname\lcreated_at\lupdated_at}"];
    exercise_workout_type [fillcolor=lightcoral, label="{exercise_workout_type|id\lname\lcreated_at\lupdated_at}"];
    exercise [fillcolor=lightcoral, label="{exercise|id\lname\lcreated_at\lupdated_at}"];
    muscle [fillcolor=lightcoral, label="{muscle|id\lname\lcreated_at\lupdated_at}"];
    program [fillcolor=lightsteelblue, label="{program|id\lname\lcreated_at\lupdated_at}"];
    programmed_exercise [fillcolor=lightcoral, label="{programmed_exercise|id\lname\lcreated_at\lupdated_at}"];
    programmed_workout [fillcolor=lightsteelblue, label="{programmed_workout|id\lname\lcreated_at\lupdated_at}"];
    set_scheme [fillcolor=lightcoral, label="{set_scheme|id\lname\lcreated_at\lupdated_at}"];
    user_equipment [fillcolor=lightsteelblue, label="{user_equipment|id\lname\lcreated_at\lupdated_at}"];
    user_exercise_preference [fillcolor=lightsteelblue, label="{user_exercise_preference|id\lname\lcreated_at\lupdated_at}"];
    user_one_rep_max [fillcolor=lightsteelblue, label="{user_one_rep_max|id\lname\lcreated_at\lupdated_at}"];
    user_program_preferences [fillcolor=lightsteelblue, label="{user_program_preferences|id\lname\lcreated_at\lupdated_at}"];
    user_weight_unit_preference [fillcolor=lightsteelblue, label="{user_weight_unit_preference|id\lname\lcreated_at\lupdated_at}"];
    user [fillcolor=lightsteelblue, label="{user|id\lname\lcreated_at\lupdated_at}"];
    workout_stage_type [fillcolor=lightsteelblue, label="{workout_stage_type|id\lname\lcreated_at\lupdated_at}"];
    workout_stage [fillcolor=lightsteelblue, label="{workout_stage|id\lname\lcreated_at\lupdated_at}"];

    // Foreign key relationships
    exercise_equipment -> exercise [label="FK"];
    exercise_equipment -> equipment [label="FK"];
    exercise_muscle -> exercise [label="FK"];
    exercise_muscle -> muscle [label="FK"];
    exercise_rotation_history -> exercise [label="FK"];
    exercise_rotation_history -> user [label="FK"];
    exercise_workout_type -> exercise [label="FK"];
    program -> user [label="FK"];
    programmed_exercise -> exercise [label="FK"];
    programmed_exercise -> workout_stage [label="FK"];
    programmed_workout -> program [label="FK"];
    set_scheme -> programmed_exercise [label="FK"];
    user_equipment -> equipment [label="FK"];
    user_equipment -> user [label="FK"];
    user_exercise_preference -> exercise [label="FK"];
    user_exercise_preference -> user [label="FK"];
    user_one_rep_max -> exercise [label="FK"];
    user_one_rep_max -> user [label="FK"];
    user_program_preferences -> user [label="FK"];
    user_weight_unit_preference -> user [label="FK"];
    user_weight_unit_preference -> exercise [label="FK"];
    workout_stage -> workout_stage_type [label="FK"];
    workout_stage -> programmed_workout [label="FK"];

    // Combined clusters for related domains
    subgraph cluster_user_program {
        label="User & Program Domains";
        style=filled;
        color=lightsteelblue;
        margin=10;
        program; programmed_workout; user_equipment; user_exercise_preference; user_one_rep_max; user_program_preferences; user_weight_unit_preference; user; workout_stage_type; workout_stage;
    }
    subgraph cluster_exercise_sets {
        label="Exercise & Sets Domains";
        style=filled;
        color=lightcoral;
        margin=10;
        equipment; exercise_equipment; exercise_muscle; exercise_rotation_history; exercise_workout_type; exercise; muscle; programmed_exercise; set_scheme;
    }

    // Invisible edges to encourage side-by-side layout
    user -> exercise [style=invis];
    exercise -> program [style=invis];
    program -> set_scheme [style=invis];
}
