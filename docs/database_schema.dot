      <tr><td align="left">equipment_name</td><td align="left"><font color="#888888">character varying</font></td></tr>
    </table>>];

  "exercise_muscle" [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="4">
      <tr><td bgcolor="#E9C2F2" colspan="2"><b>exercise_muscle</b></td></tr>
