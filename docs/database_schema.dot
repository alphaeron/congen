      <tr><td align="left">concentric_tempo</td><td align="left"><font color="#888888">character</font></td></tr>
      <tr><td align="left">target_weight</td><td align="left"><font color="#888888">numeric</font></td></tr>
      <tr><td align="left">performed_weight</td><td align="left"><font color="#888888">numeric</font></td></tr>
      <tr><td align="left">target_rep_count</td><td align="left"><font color="#888888">smallint</font></td></tr>
      <tr><td align="left">performed_rep_count</td><td align="left"><font color="#888888">smallint</font></td></tr>
      <tr><td align="left">rest_seconds</td><td align="left"><font color="#888888">smallint</font></td></tr>
      <tr><td align="left">created_at</td><td align="left"><font color="#888888">timestamp without time zone</font></td></tr>
      <tr><td align="left">updated_at</td><td align="left"><font color="#888888">timestamp without time zone</font></td></tr>
      <tr><td align="left">band_weight_lbs</td><td align="left"><font color="#888888">numeric</font></td></tr>
    </table>>];

  "user" [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="4">
      <tr><td bgcolor="#E9C2F2" colspan="2"><b>user</b></td></tr>
      <tr><td align="left">id</td><td align="left"><font color="#888888">integer</font></td></tr>
