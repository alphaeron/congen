      <tr><td align="left">programmed_exercise_id</td><td align="left"><font color="#888888">bigint</font></td></tr>
      <tr><td align="left">set_number</td><td align="left"><font color="#888888">smallint</font></td></tr>
      <tr><td align="left">is_amrap</td><td align="left"><font color="#888888">boolean</font></td></tr>
      <tr><td align="left">is_emom</td><td align="left"><font color="#888888">boolean</font></td></tr>
