    </table>>];

  "programmed_exercise" [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="4">
      <tr><td bgcolor="#E9C2F2" colspan="2"><b>programmed_exercise</b></td></tr>
      <tr><td align="left">id</td><td align="left"><font color="#888888">bigint</font></td></tr>
      <tr><td align="left">workout_stage_id</td><td align="left"><font color="#888888">bigint</font></td></tr>
