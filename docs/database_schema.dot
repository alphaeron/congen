digraph G {
  graph [rankdir=LR, fontsize=10];
  node [shape=plaintext];
  "equipment" [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="4">
      <tr><td bgcolor="#E9C2F2" colspan="2"><b>equipment</b></td></tr>
      <tr><td align="left">name</td><td align="left"><font color="#888888">character varying</font></td></tr>
      <tr><td align="left">description</td><td align="left"><font color="#888888">text</font></td></tr>
    </table>>];

  "exercise" [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="4">
      <tr><td bgcolor="#E9C2F2" colspan="2"><b>exercise</b></td></tr>
      <tr><td align="left">name</td><td align="left"><font color="#888888">character varying</font></td></tr>
      <tr><td align="left">description</td><td align="left"><font color="#888888">text</font></td></tr>
      <tr><td align="left">movement_type</td><td align="left"><font color="#888888">character varying</font></td></tr>
      <tr><td align="left">is_unilateral</td><td align="left"><font color="#888888">boolean</font></td></tr>
      <tr><td align="left">is_upper</td><td align="left"><font color="#888888">boolean</font></td></tr>
      <tr><td align="left">is_accessory</td><td align="left"><font color="#888888">boolean</font></td></tr>
    </table>>];

  "exercise_equipment" [label=<
    <table border="1" cellborder="0" cellspacing="0" cellpadding="4">
      <tr><td bgcolor="#E9C2F2" colspan="2"><b>exercise_equipment</b></td></tr>
